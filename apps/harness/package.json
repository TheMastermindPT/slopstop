{
  "name": "@slopstop/harness",
  "version": "0.0.0",
  "private": true,
  "description": "SlopStop transport-independent harness runtime.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "pnpm db:generate:application && pnpm db:generate:canonical && pnpm db:generate:runtime",
    "db:generate:application": "drizzle-kit generate --config drizzle.application.config.ts",
    "db:generate:canonical": "drizzle-kit generate --config drizzle.canonical.config.ts",
    "db:generate:check": "node scripts/check-generated-migrations.mjs",
    "db:generate:runtime": "drizzle-kit generate --config drizzle.runtime.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@slopstop/protocol": "workspace:*",
    "drizzle-orm": "catalog:",
    "fs-native-extensions": "catalog:",
    "libsql": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
