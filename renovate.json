{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "schedule": ["before 6am on monday"],
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Keep Electron Forge packages on one version",
      "matchPackageNames": ["@electron-forge/**"],
      "groupName": "electron forge"
    },
    {
      "description": "Keep Vitest packages on one version",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "groupName": "vitest"
    },
    {
      "description": "Group Sentry SDK updates",
      "matchPackageNames": ["@sentry/**"],
      "groupName": "sentry"
    },
    {
      "description": "TypeScript and the Effect build move together, each bump approved after the tsc.exe hash check",
      "matchPackageNames": [
        "typescript",
        "@typescript/native",
        "@typescript/typescript6",
        "@effect/tsgo",
        "@effect/tsgo-*"
      ],
      "groupName": "typescript and effect-tsgo",
      "dependencyDashboardApproval": true
    }
  ]
}
