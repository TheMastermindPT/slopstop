{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "apps/desktop/src/main/desktop-shutdown.ts",
    "apps/desktop/src/main/desktop-runtime.ts",
    "apps/desktop/src/main/ipc-gate.ts",
    "apps/desktop/src/main/ipc-sender.ts",
    "apps/desktop/src/main/project-entry-ipc.ts",
    "apps/desktop/src/main/project-registration-ipc.ts:36-36",
    "apps/desktop/src/main/project-registration-ipc.ts:44-44",
    "apps/desktop/src/main/project-registration-ipc.ts:65-73",
    "apps/desktop/src/main/main.ts:108-118",
    "apps/desktop/src/main/writer-proof-report.ts:4-18",
    "apps/desktop/src/main/workspace-ipc.ts",
    "apps/desktop/src/main/main.ts:408-408",
    "apps/desktop/src/main/canonical-writer-package-smoke.ts:302-343"
