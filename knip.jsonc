{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // @effect/tsgo ships the Effect tsgo language-server binary used by the editor and agent LSP (no JS import);
  // the tsconfig plugin name @effect/language-service is resolved by that binary, not installed as a package.
  "ignoreDependencies": ["@effect/tsgo", "@effect/language-service"],
  "workspaces": {
    ".": {
      "project": ["*.{cjs,js,mjs,ts}"]
    },
    "apps/desktop": {
      "entry": [
        "forge.config.ts",
        "src/main/main.ts",
        "src/preload/preload.ts",
        "src/renderer/prototype/main.tsx",
        "tests/e2e/**/*.{mjs,ts}",
        "vitest.project-storage-mutation.config.ts",
        "vite.*.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "*.config.ts"]
    },
    "apps/harness": {
      "entry": [
        "drizzle.*.config.ts",
        "src/process-entry.ts",
        "src/storage/{application,canonical,runtime}-schema.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/kernel": {
      "project": ["src/**/*.ts"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    }
  }
}
