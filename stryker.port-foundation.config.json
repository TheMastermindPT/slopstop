{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["apps/desktop/src/main/window-chrome.ts", "apps/desktop/src/main/application-menu.ts"],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "apps/desktop/vitest.port-foundation-mutation.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": false,
  "concurrency": 4,
  "reporters": ["json", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/port-foundation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
