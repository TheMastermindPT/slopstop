{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/kernel/src/workspace-identifiers.ts",
    "packages/protocol/src/protocol.ts",
    "packages/protocol/src/project-upgrade-protocol.ts",
    "packages/protocol/src/workspace-protocol.ts",
    "packages/protocol/src/project-conversation-protocol.ts",
    "packages/protocol/src/canonical-project-protocol.ts:156-156",
    "packages/protocol/src/canonical-project-protocol.ts:252-252",
    "packages/protocol/src/canonical-project-protocol.ts:419-419",
    "apps/harness/src/workspace-application.ts",
    "apps/harness/src/harness-runtime.ts",
    "apps/harness/src/active-project-conversation.ts",
    "apps/harness/src/active-work-admission.ts",
    "apps/harness/src/active-project-coordinator.ts:513-539",
    "apps/harness/src/active-project-coordinator.ts:705-708",
    "apps/harness/src/active-project-coordinator.ts:715-724",
    "apps/harness/src/canonical-project-application.ts:90-101",
    "apps/harness/src/canonical-project-application.ts:107-118",
    "apps/harness/src/registration/project-registration-preparation.ts:225-279",
    "apps/harness/src/registration/project-registration-preparation.ts:294-307",
    "apps/harness/src/registration/project-registration-preparation.ts:367-383",
    "apps/harness/src/registration/registration-listing.ts",
    "apps/desktop/src/main/harness-session.ts",
    "apps/desktop/src/main/harness-supervisor.ts",
    "apps/desktop/src/main/harness-log-lines.ts",
    "apps/desktop/src/main/workspace-bridge.ts",
    "apps/desktop/src/main/package-smoke-verifier.ts",
    "apps/desktop/src/main/project-upgrade-failure.ts",
    "apps/desktop/src/main/harness-pending-request.ts",
    "apps/desktop/src/preload/preload.ts",
    "apps/desktop/src/renderer/use-project-upgrade.ts"
  ],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "reports/mutation/incremental.json",
  "concurrency": 4,
  "reporters": ["json", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
