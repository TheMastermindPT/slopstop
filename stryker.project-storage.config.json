{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/protocol/src/project-storage-protocol.ts",
    "apps/harness/src/process-fatal-diagnostics.ts",
    "apps/harness/src/storage/sqlite-schema-expression.ts",
    "apps/harness/src/storage/project-storage-database-specs.ts",
    "apps/harness/src/storage/project-storage-spec-builders.ts",
    "apps/harness/src/storage/project-storage-conversation-specs.ts",
    "apps/harness/src/storage/database-schema-verifier.ts",
    "apps/harness/src/storage/project-storage-upgrade-eligibility.ts",
    "apps/harness/src/storage/generated-migrations.ts",
    "apps/harness/src/storage/project-storage-manifest.ts",
    "apps/harness/src/storage/project-storage-upgrade-recovery.ts",
    "apps/harness/src/storage/application-database-migration.ts:142-284",
    "apps/harness/src/storage/project-storage-healthy-opening.ts:108-115",
    "apps/harness/src/storage/project-storage-healthy-opening.ts:147-153",
    "apps/harness/src/storage/project-storage-database-authority.ts:189-194",
    "apps/harness/src/storage/project-storage-node-registry.ts",
    "apps/harness/src/storage/project-storage-locks.ts"
  ],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "apps/harness/vitest.project-storage-mutation.config.ts",
    "related": true
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": false,
  "concurrency": 4,
  "reporters": ["json", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/project-storage-harness.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
