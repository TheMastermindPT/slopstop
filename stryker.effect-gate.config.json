{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["apps/harness/scripts/check-effect-diagnostics.mjs"],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "apps/harness/vitest.effect-gate-mutation.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": false,
  "concurrency": 4,
  "reporters": ["json", "html"],
  "jsonReporter": {
    "fileName": "reports/mutation/effect-gate.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/effect-gate.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
